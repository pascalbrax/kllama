# Opt-in per-user integration for running an uninstalled development build.
if(NOT DEFINED DESKTOP_FILE OR NOT DEFINED ICON_FILE)
    message(FATAL_ERROR "Desktop and icon source paths are required")
endif()
if(DEFINED ENV{XDG_DATA_HOME} AND NOT "$ENV{XDG_DATA_HOME}" STREQUAL "")
    set(data_home "$ENV{XDG_DATA_HOME}")
else()
    set(data_home "$ENV{HOME}/.local/share")
endif()
if(NOT IS_ABSOLUTE "${data_home}")
    message(FATAL_ERROR "The user data directory must be absolute")
endif()
file(INSTALL "${DESKTOP_FILE}" DESTINATION "${data_home}/applications")
file(INSTALL "${ICON_FILE}" DESTINATION "${data_home}/icons/hicolor/scalable/apps")
find_program(UPDATE_DESKTOP_DATABASE update-desktop-database)
if(UPDATE_DESKTOP_DATABASE)
    execute_process(COMMAND "${UPDATE_DESKTOP_DATABASE}" "${data_home}/applications"
        RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(WARNING "Desktop cache update failed; the entry was installed successfully")
    endif()
endif()
message(STATUS "Registered the Kllama build in ${data_home}/applications; rerun after moving the build")
